# {{ ansible_managed }}
# Tuning only. `gzip on;` is already in Debian's stock nginx.conf, and nginx
# rejects a directive given twice in http {} — which is where conf.d/ lands.
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 256;
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/xml
    application/javascript
    application/json
    application/xml
    application/rss+xml
    image/svg+xml
    font/ttf
    application/vnd.ms-fontobject;
