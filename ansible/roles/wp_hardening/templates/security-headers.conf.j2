# {{ ansible_managed }}
add_header X-Frame-Options SAMEORIGIN always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
{% if enable_tls %}
add_header Strict-Transport-Security "max-age={{ hsts_max_age }}; includeSubDomains" always;
{% endif %}
# A Content-Security-Policy is deliberately omitted by default — most WP
# themes/plugins break under a strict CSP. Add one here once tested.
